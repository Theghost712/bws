# ---- Django core -----------------------------------------------------------
# Generate a new key for production:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Nairobi

# Comma separated origins trusted for CSRF when DEBUG=False (include scheme)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Used in reminder emails
SITE_BASE_URL=http://127.0.0.1:8000

# Public contact details shown in the footer and on the contact page
SITE_EMAIL=menyendoyemigaru@gmail.com
SITE_PHONE=+255 747 433 510

# ---- Database (leave DB_ENGINE unset for SQLite locally) -------------------
# DB_ENGINE=mysql
# DB_NAME=paveline
# DB_USER=paveline
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Postgres (e.g. Vercel Postgres / Neon) takes priority when set.
# On Vercel this is injected automatically by the Neon integration.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require

# ---- Vercel ----------------------------------------------------------------
# Vercel sets VERCEL=1 automatically; setting DJANGO_DEBUG here overrides it.
# Used by the /cron/send-reminders/ endpoint (Vercel Cron sends it as a bearer
# token). Keep it secret.
# CRON_SECRET=change-me

# ---- Email -----------------------------------------------------------------
# Local development uses the console backend (emails print to the terminal).
# Setting EMAIL_HOST selects the SMTP backend automatically.
EMAIL_HOST=
EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-user
# EMAIL_HOST_PASSWORD=your-password
DEFAULT_FROM_EMAIL=paveline@example.com

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE=5242880

# Object storage for user uploads (S3-compatible). Enabling
# AWS_STORAGE_BUCKET_NAME (or USE_S3_MEDIA=1) switches the default storage
# from local disk to the bucket.
# USE_S3_MEDIA=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_QUERYSTRING_AUTH=True

# ---- Error monitoring (optional) -------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# ---- Production security ---------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
