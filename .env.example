# ---- Django core -----------------------------------------------------------
# Generate a new key for production:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Nairobi

# Comma separated origins trusted for CSRF when DEBUG=False (include scheme)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Used in reminder emails
SITE_BASE_URL=http://127.0.0.1:8000

# Public contact details shown in the footer and on the contact page
SITE_EMAIL=menyendoyemigaru@gmail.com
SITE_PHONE=+255 747 433 510

# ---- Database (leave DB_ENGINE unset for SQLite locally) -------------------
# DB_ENGINE=mysql
# DB_NAME=paveline
# DB_USER=paveline
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---- Email -----------------------------------------------------------------
# Local development uses the console backend (emails print to the terminal).
# For production use SMTP, e.g.:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-user
# EMAIL_HOST_PASSWORD=your-password
DEFAULT_FROM_EMAIL=paveline@example.com

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE=5242880

# ---- Production security ---------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
