# Paveline Bot Configuration
BOT_NAME=Paveline Bot
BOT_USERNAME=paveline_bot
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Admin IDs (comma separated, get from @userinfobot)
ADMIN_IDS=

# AI Provider: gemini | groq | openrouter | ollama | fallback
AI_PROVIDER=ollama

# API Keys (required only for chosen provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Ollama (local, free, offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Scheduling
SEND_TIME=07:00
TIMEZONE=Africa/Dar_es_Salaam

# Database
DB_URL=sqlite:///./paveline.db

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=paveline@example.com
SMTP_USE_TLS=true

# Dry run mode (true/false)
DRY_RUN=false
